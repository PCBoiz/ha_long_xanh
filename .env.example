# Mẫu cấu hình. Chép file này thành `.env` rồi điền giá trị thật.
#
# ⚠️  FILE `.env` KHÔNG BAO GIỜ ĐƯỢC ĐƯA LÊN GITHUB. Nó đã nằm trong
#     `.gitignore`. Ai có file này là có toàn quyền ghi vào cơ sở dữ liệu và
#     đăng bài lên trang.

# ─────────────────────────── BẮT BUỘC ĐỂ CHẠY ───────────────────────────────

# Tên miền CHÍNH THỨC, KHÔNG có https:// và KHÔNG có dấu / ở cuối.
# Mọi địa chỉ khác chuyển hướng 301 về đây.
TEN_MIEN=halongxanh360.vn

# Tên miền PHỤ — chuyển hướng về tên miền chính (kèm cả dạng www).
#
# ⚠️ Chỉ có MỘT tên miền thì phải XOÁ HAI KHỐI tương ứng trong Caddyfile chứ
#    không phải để trống dòng này. Trống thì Caddy nhận địa chỉ rỗng và từ
#    chối khởi động — mất cả trang.
TEN_MIEN_PHU=halongxanh360.com.vn

# Email nhận cảnh báo khi chứng chỉ SSL sắp hết hạn mà gia hạn thất bại.
#
# ⚠️ PHẢI LÀ HỘP THƯ NẰM NGOÀI TÊN MIỀN NÀY. Gmail, Outlook — thứ gì cũng được,
#    miễn không phải @halongxanh360.vn.
#
# Lý do: đây là kênh báo động cho những sự cố mà chính tên miền là nạn nhân.
# Chứng chỉ hết hạn, DNS trỏ sai, tên miền quên gia hạn — cả ba đều làm hộp thư
# trên chính tên miền đó ngừng nhận. Đặt địa chỉ báo động ở đó là dựng một cái
# chuông báo cháy nằm trong phòng đang cháy.
#
# Điền email bạn MỞ HẰNG NGÀY. Thư này một năm chỉ tới một lần, và lần đó là
# lần trang sắp tắt.
EMAIL_SSL=

# Địa chỉ đầy đủ của trang, CÓ https://. Dùng cho sitemap, thẻ chia sẻ và
# canonical. Sai giá trị này thì Google đi thu thập nhầm tên miền.
NEXT_PUBLIC_SITE_URL=https://halongxanh360.vn

# ─────────────────────────── CƠ SỞ DỮ LIỆU ──────────────────────────────────

# Chuỗi kết nối Neon. Lấy ở bảng điều khiển Neon → Connection string.
# Phải là chuỗi có `-pooler` và kết thúc bằng `?sslmode=require`.
DATABASE_URL=postgresql://nguoi_dung:mat_khau@ep-abc-123-pooler.ap-southeast-1.aws.neon.tech/ten_db?sslmode=require

# ─────────────────── CỔNG NHẬN BÀI TỪ ANTIGRAVITY ───────────────────────────

# Mật khẩu để Antigravity được phép đăng bài lên trang này.
#
# Sinh bằng lệnh (chạy trên máy chủ):
#   openssl rand -base64 48
#
# Giá trị này phải TRÙNG KHỚP với `VINHOMES_INGEST_TOKEN` bên Antigravity.
# Chừng nào ô này còn trống, cổng nhận bài trả lỗi 503 và từ chối mọi bài —
# cố ý, để không ai đăng được gì lên trang khi chưa cấu hình.
INGEST_TOKEN=

# ──────────────────── NƠI NHẬN ĐĂNG KÝ CỦA KHÁCH ────────────────────────────

# Địa chỉ nhận thông tin khách điền vào biểu mẫu tư vấn — CRM, Google Apps
# Script, n8n, Zapier, hay bất cứ thứ gì nhận được một POST kèm JSON.
#
# ⚠️ ĐỂ TRỐNG LÀ MẤT KHÁCH, VÀ MẤT KHÔNG BÁO.
#
# Trống thì ứng dụng ghi thông tin xuống một file tạm bên trong hộp chứa. Lần
# triển khai kế tiếp dựng lại hộp chứa là mất sạch — kèm số điện thoại thật
# của những người thật đã tin tưởng để lại. Khách vẫn thấy màn hình cảm ơn,
# không có lỗi nào hiện ra, chỉ là không ai gọi lại cho họ.
#
# Đây là ô đáng điền trước cả tên miền: chưa có nó thì mọi đồng quảng cáo đổ
# vào trang đều chảy vào một cái thùng thủng.
#
# CÁCH ĐIỀN (11/09): trong Antigravity → Website của tôi → chọn dự án → thẻ
# "Khách liên hệ → Google Sheets" → bấm "Lập bảng". Nó đưa ra ĐÚNG HAI DÒNG để
# dán vào đây. Token chỉ hiện một lần lúc lập — chép ngay.
#
# Mỗi lượt khách để lại số thành một dòng trong Google Sheet của bạn, ghi bằng
# tài khoản Google đã kết nối trong Antigravity. Không cần Apps Script nữa.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# ─────────────────────────── LẬP CHỈ MỤC ────────────────────────────────────

# Để `0` cho tới khi số liệu dự án đã đối chiếu hồ sơ gốc. Chừng nào còn `0`,
# mọi trang gắn `noindex` và robots.txt chặn sạch — Google sẽ không lập chỉ mục.
# Đổi thành `1` là mở cho công cụ tìm kiếm vào.
NEXT_PUBLIC_CHO_LAP_CHI_MUC=1
